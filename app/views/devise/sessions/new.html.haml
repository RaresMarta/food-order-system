%section.auth-hero
  .background
  .hero-content.d-flex.justify-content-center.align-items-center
    .card.shadow
      .card-body.p-4
        %h2.text-center.mb-4.fw-semibold Welcome Back

        = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
          .mb-3
            = f.label :email, "Email", class: "form-label text-muted small fw-medium"
            = f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control", placeholder: "Enter your email address", required: true

          .mb-3
            = f.label :password, "Password", class: "form-label text-muted small fw-medium"
            = f.password_field :password, autocomplete: "current-password", class: "form-control", placeholder: "Enter your password", required: true

          - if devise_mapping.rememberable?
            .mb-3.form-check
              = f.check_box :remember_me, class: "form-check-input"
              = f.label :remember_me, class: "form-check-label"

          .d-grid.mb-3
            = f.submit "Log in", class: "btn btn-primary"

        .text-center.mt-4.pt-3.border-top
          = render "devise/shared/links"
